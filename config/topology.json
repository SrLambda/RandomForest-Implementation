{
  "schema_version": 3,
  "dataset": "RE2-SS",
  "system": "Sock Shop",
  "data_config": {
    "root": "data/raw/RCAEval",
    "index_file": "cases.parquet",
    "metrics_file": "metrics.parquet",
    "time_column": "time",
    "timestamp_unit": "unix_seconds",
    "metric_column_pattern": "{service}_{metric}",
    "missing_values_policy": "preserve_nan",
    "missing_optional_columns_policy": "preserve_as_unavailable",
    "unit_conversion": "none"
  },
  "detector_config": {
    "sampling_interval_sec": 1.0,
    "baseline_window_sec": 60,
    "warmup_sec": 60,
    "z_score_threshold": 3.0,
    "anomaly_consecutive_sec": 5,
    "recovery_consecutive_sec": 5,
    "diagnosis_delay_sec": 10,
    "max_anomaly_window_sec": 120,
    "anomaly_direction_by_family": {"latency": "increase"},
    "minimum_deviation_multiplier_by_family": {"latency": 1.3},
    "decrease_deviation_multiplier_by_family": {"network_sockets": 1.8},
    "fixed_reference_families": ["cpu"],
    "relative_increase_factor_by_family": {"latency": 10.0},
    "relative_reference_max_cv": 0.25
  },
  "allow_external_service_references": false,
  "metric_families": {
    "cpu": "cpu",
    "mem": "memory",
    "socket": "network_sockets",
    "error": "errors",
    "latency-50": "latency",
    "latency-90": "latency",
    "diskio": "disk",
    "workload": "workload"
  },
  "services": [
    {
      "name": "carts",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "latency-50", "latency-90", "mem", "socket", "workload"],
      "optional_metrics": ["diskio", "error"]
    },
    {
      "name": "carts-db",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "diskio", "mem", "socket"],
      "optional_metrics": []
    },
    {
      "name": "catalogue",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "latency-50", "latency-90", "mem", "socket", "workload"],
      "optional_metrics": ["diskio", "error"]
    },
    {
      "name": "catalogue-db",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "diskio", "mem", "socket"],
      "optional_metrics": []
    },
    {
      "name": "front-end",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "latency-50", "latency-90", "mem", "socket", "workload"],
      "optional_metrics": ["error"]
    },
    {
      "name": "istio-init",
      "upstream": null,
      "downstream": null,
      "required_metrics": [],
      "optional_metrics": ["mem", "socket"]
    },
    {
      "name": "orders",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "latency-50", "latency-90", "mem", "socket", "workload"],
      "optional_metrics": ["diskio", "error"]
    },
    {
      "name": "orders-db",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "diskio", "mem", "socket"],
      "optional_metrics": []
    },
    {
      "name": "payment",
      "upstream": null,
      "downstream": null,
      "required_metrics": ["cpu", "latency-50", "latency-90", "mem", "socket", "workload"],
      "optional_metrics": ["diskio", "error"]
    },
    {
      "name": "queue-master",
      "upstream": null,
